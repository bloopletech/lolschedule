- vod_urls.map! { |vod_url| Build::VodUrl.new(vod_url) }
- multiple = vod_urls.length > 1
- vod_urls.each_with_index do |vod, i|
  - classes = []
  - classes << "revealed" if i == 0
  - classes << "expired" if vod.expired?(rtime)
  %a.data.vod{href: vod.url, data: vod.to_h, target: "_blank", class: classes}
    - if multiple
      vod #{i + 1}
    - else
      vod
